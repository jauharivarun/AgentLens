# Same variables as the project-root .env.example.
# Fill THIS file or the root .env — not both. You only need one.
# The backend reads both; if both exist, this file wins.

# OpenAI — required for OpenAI models
OPENAI_API_KEY=

# Groq — required to show and run Groq models in the dropdown
GROQ_API_KEY=

# Chroma Cloud — required for hosted RAG
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Supabase Postgres — required for persistent telemetry
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AGENT_MAX_ITERATIONS=12
WORKSPACE_PATH=sample_workspace
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
